# Copy to .env and fill in real values. VITE_* vars are embedded in the
# client bundle (must be set at build time); non-VITE vars are server-side
# only (Supabase Edge Function secrets via `supabase secrets set`).

# Supabase project (VITE_ = exposed to the browser)
VITE_SUPABASE_URL=https://isyksrqsrwqblqwtbkwb.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Manual payment instructions shown in the Pricing page checkout modal.
# Each value is free-form text displayed verbatim to the customer; use \n
# for line breaks.
VITE_BANK_DETAILS=Stanbic Bank - Account Name: Tugume edwi millenium Name - Account Number: 9030024608394 - Branch: Lugogo
VITE_MTN_MOMO=MTN Mobile Money: 0789945073 - Registered Name: Tugume edwi millenium
VITE_AIRTEL_MONEY=Airtel Money: 0755849638 - Registered Name: Tugume edwi millennium

# Optional: fallback Stripe Pro price id when plans.stripe_price_id is empty
VITE_STRIPE_PRO_PRICE_ID=price_PRO_PLACEHOLDER
